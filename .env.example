# Local source parsing/manual review is explicit, loopback-only, and never enabled on Vercel.
FIELDOPS_LOCAL_MODE=false
# Optional private local directory. Default: .fieldops inside this repository (gitignored).
# FIELDOPS_DATA_DIR=

# Free Supabase project; no paid add-ons. Never expose the service-role key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact deployed origin, e.g. https://fieldops-example.vercel.app
FIELDOPS_SITE_URL=

# Free Trigger.dev project only. Keep the org on Free; configure plan limit and stop active runs.
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=

# Leave empty/false to keep AI integration disabled. Existing desktop subscriptions are not API keys.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_TIER_CONFIRMED=false
GROQ_ZDR_CONFIRMED=false
