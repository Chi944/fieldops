# All credentials below are server-only. Never use NEXT_PUBLIC_ names for them.
# Copy this template only when .env.local does not already exist.
# The personal launcher defaults to parser-only; --ai reads only model settings from .env.ai.local.
FIELDOPS_LOCAL_MODE=false
FIELDOPS_PROCESSING_MODE=parse_only
# Operator pause: false blocks new cloud uploads, finalization and processing retries.
# Saved work stays accessible; local personal uploads and already running jobs are unaffected.
FIELDOPS_UPLOADS_ENABLED=true
# Optional local paths; leave unset on Vercel and Trigger.
# FIELDOPS_DATA_DIR=
# FIELDOPS_OCR_DATA_DIR=

# Neon Free: restricted fieldops_runtime login, with TLS. Required on web + worker.
# Never substitute integration-managed DATABASE_URL: that is the migration-owner credential.
FIELDOPS_DATABASE_URL=

# Managed Neon Auth, web only. Use this project's branch Auth endpoint.
NEON_AUTH_BASE_URL=
# Privately generated random secret of at least 32 characters; not a provider key.
NEON_AUTH_COOKIE_SECRET=
# Exact HTTPS deployed origin; no path. Also set it as a Neon Auth trusted origin.
FIELDOPS_SITE_URL=

# Private Neon object storage, web + worker. No separate AWS account is needed.
# HTTPS branch S3 endpoint, not the Auth or PostgreSQL endpoint.
NEON_STORAGE_ENDPOINT=
# Neon storage credential token_id and s3_secret_access_key respectively.
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
# Ohio project: us-east-2. Must match the selected Neon storage region.
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=quotations

# Dedicated Trigger.dev Free project. Set separately on Vercel and Trigger production.
# Keep Free, set the plan billing limit and cancel active runs on exhaustion.
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=

# Activation requires ai mode, a supported model, this key and both account flags.
# Keep empty/false until Groq Free Plan and Zero Data Retention are confirmed.
# Desktop Claude, Codex and Cursor subscriptions are not application API credentials.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_TIER_CONFIRMED=false
GROQ_ZDR_CONFIRMED=false
